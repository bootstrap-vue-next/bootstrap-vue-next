{
  "separate-pull-requests": true,
  "include-component-in-tag": true,

  "packages": {
    "packages/bootstrap-vue-next": {
      "component": "bootstrapvuenext",
      "release-type": "node"
    },
    "packages/nuxt": {
      "component": "nuxt",
      "release-type": "node"
    },
    "packages/mcp": {
      "component": "mcp",
      "release-type": "node"
    }
  },
  "plugins": [
    {
      "type": "node-workspace",
      "merge": false
    }
  ],
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
