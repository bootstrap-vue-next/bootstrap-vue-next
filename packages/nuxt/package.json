{
  "name": "@bootstrap-vue-next/nuxt",
  "description": "Nuxt Module for BootstrapVueNext",
  "version": "0.45.10",
  "license": "MIT",
  "author": {
    "name": "Issayah",
    "url": "https://github.com/VividLemon"
  },
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxt dev playground --port 3030",
    "build": "pnpm run dev:prepare && pnpm run dev:build && pnpm run prepack",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "publint": "publint",
    "lint": "eslint --fix",
    "test:lint": "eslint",
    "test:lint:ci": "pnpm run test:lint",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test": "run-s test:lint test:unit",
    "test:ci": "run-s test:lint:ci test:unit:ci",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "peerDependencies": {
    "bootstrap-vue-next": "workspace:^"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@types/node": "^24.13.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "bootstrap-vue-next": "workspace:^",
    "eslint": "^10.8.1",
    "npm-run-all2": "^8.0.4",
    "nuxt": "^4.5.2",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue": "3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bootstrap-vue-next/bootstrap-vue-next.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/bootstrap-vue-next/bootstrap-vue-next/issues"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/bootstrap-vue-next"
  },
  "homepage": "https://github.com/bootstrap-vue-next/bootstrap-vue-next",
  "keywords": [
    "vue3",
    "vue",
    "nuxt",
    "bootstrap",
    "typescript",
    "bootstrap-vue-next"
  ],
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "!(CHANGELOG)*.md": "prettier --write --ignore-unknown",
    "!(*md)": "prettier --write --ignore-unknown"
  }
}
